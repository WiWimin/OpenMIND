  "negatives": [
    {
      "question": "公司食堂下周的菜单是什么？",
      "category": "domain_irrelevant",
      "note": "域内话题但无任何语料覆盖"
    },
    {
      "question": "年会定在几月几号举办？",
      "category": "domain_irrelevant",
      "note": "域内话题但无任何语料覆盖"
    },
    {
      "question": "隔壁组的 HC 还招人吗？",
      "category": "domain_irrelevant",
      "note": "域内话题但无任何语料覆盖"
    },
    {
      "question": "上海明天的天气怎么样？",
