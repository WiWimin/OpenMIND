{
  "version": 1,
  "description": "OpenMIND RAG 检索评测集：知识库 scope 10 篇 + 会议材料 scope 8 篇，每篇 2 条标注问题（文档级期望 doc_key + chunk 级内容断言），负样本 8 条按 domain_irrelevant / out_of_domain / noise 分类。",
  "fixed_config": {
    "top_k": 5,
    "min_score": 0.3,
    "chunk_size": 800,
    "chunk_overlap": 120,
    "retrieval_path": "app layer VectorRetriever (same implementation as production chat/search)",
    "ingest_path": "backend HTTP API /api/v1/*"
  },
  "admission": {
    "knowledge_base.hit_at_5": 0.85,
    "current_meeting.hit_at_5": 0.8,
    "overall.mrr": 0.5,
    "negatives.interception_rate": 1.0,
    "note": "首轮为基线，未达标时报告须给出错误分析，不自动放宽阈值"
  },
  "corpus": [
    {
      "doc_key": "kb-leave",
      "scope": "knowledge_base",
      "file": "corpus/kb-leave-policy.txt",
      "questions": [
        {
          "question": "员工工龄 12 年，每年有几天年假？",
          "expect_chunk_contains": "工龄 10-20 年每年 10 天"
        },
        {
          "question": "年假最晚可以顺延到什么时候？",
          "expect_chunk_contains": "次年 3 月 31 日"
        }
      ]
    },
    {
      "doc_key": "kb-expense",
      "scope": "knowledge_base",
      "file": "corpus/kb-expense-policy.txt",
      "questions": [
        {
          "question": "一线城市住宿每晚报销上限是多少？",
          "expect_chunk_contains": "一线城市每晚不超过 600 元"
        },
        {
          "question": "报销单提交的时限是多久？",
          "expect_chunk_contains": "行程结束后 15 个工作日内"
        }
      ]
    },
    {
      "doc_key": "kb-meeting-room",
      "scope": "knowledge_base",
      "file": "corpus/kb-meeting-room-rules.txt",
      "questions": [
        {
          "question": "预订后多久无人使用会被自动释放？",
          "expect_chunk_contains": "开始后 15 分钟"
        },
        {
          "question": "超过 30 人的会议应预订什么场地？",
          "expect_chunk_contains": "多功能厅"
        }
      ]
    },
    {
      "doc_key": "kb-oncall",
      "scope": "knowledge_base",
      "file": "corpus/kb-oncall-rotation.txt",
      "questions": [
        {
          "question": "值班人员响应告警的时限是多久？",
          "expect_chunk_contains": "15 分钟内响应告警"
        },
        {
          "question": "P0 级故障的通知方式有什么要求？",
          "expect_chunk_contains": "立即电话通知技术负责人"
        }
      ]
    },
    {
      "doc_key": "kb-pricing",
      "scope": "knowledge_base",
      "file": "corpus/kb-product-pricing.txt",
      "questions": [
        {
          "question": "专业版一年多少钱？",
          "expect_chunk_contains": "专业版每年 29800 元"
        },
        {
          "question": "年付有折扣吗？",
          "expect_chunk_contains": "年付按 8.5 折结算"
        }
      ]
    },
    {
      "doc_key": "kb-sla",
      "scope": "knowledge_base",
      "file": "corpus/kb-support-sla.txt",
      "questions": [
        {
          "question": "普通问题的解决时限是多久？",
          "expect_chunk_contains": "8 个工作小时内解决"
        },
        {
          "question": "未达可用性承诺如何补偿？",
          "expect_chunk_contains": "双倍时长补偿服务期"
        }
      ]
    },
    {
      "doc_key": "kb-security",
      "scope": "knowledge_base",
      "file": "corpus/kb-security-spec.txt",
      "questions": [
        {
          "question": "密码多久强制更换一次？",
