+
+    await expect(page).toHaveURL(/\/dashboard$/)
+    await expect(page.getByRole('heading', { name: /OpenMIND 智能会议助手/ })).toBeVisible()
+
+    // 刷新后仍保持登录态（令牌已持久化到 localStorage）
+    await page.reload()
+    await expect(page).toHaveURL(/\/dashboard$/)
+    await expect(page.getByRole('heading', { name: /OpenMIND 智能会议助手/ })).toBeVisible()
+  })
+})

