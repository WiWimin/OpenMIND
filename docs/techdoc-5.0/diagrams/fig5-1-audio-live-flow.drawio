<mxfile host="app.diagrams.net" version="24.0.0" type="device"><diagram id="fig5-1-audio-live-flow" name="fig5-1-audio-live-flow"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b0" value="开始实时会话&#10;POST /audio/live/start → processing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F8;strokeColor=#64748B;fontColor=#1E293B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="40" width="360" height="64" as="geometry"/></mxCell><mxCell id="b1" value="上传分片&#10;live/chunk（seq, offset_seconds）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F8;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="360" height="64" as="geometry"/></mxCell><mxCell id="b2" value="保存分片文件&#10;audio/{id}/chunks/000N.ext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#1E293B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="360" height="64" as="geometry"/></mxCell><mxCell id="b3" value="逐片 ASR&#10;TranscriptionClient（外部/本地 FunASR）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F0;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="360" height="64" as="geometry"/></mxCell><mxCell id="b4" value="追加分段 + 重建全文&#10;segments[{seq, offset_seconds, text}]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2F0;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="360" height="64" as="geometry"/></mxCell><mxCell id="b5" value="结束：合并分片 + 清理&#10;live/finish → transcribed / failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="510" width="360" height="64" as="geometry"/></mxCell><mxCell id="b6" value="标记 + 编辑转写&#10;segments/marker、PATCH /audio/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="610" width="360" height="64" as="geometry"/></mxCell><mxCell id="b7" value="确认 → 生成会议记录&#10;confirm → RecordType.transcript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0F8;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="360" height="64" as="geometry"/></mxCell><mxCell id="b8" value="分片失败：记录 error（不中断）&#10;segment.error 保留，整体继续处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="380" width="380" height="70" as="geometry"/></mxCell><mxCell id="b9" value="分片重试&#10;POST /audio/{id}/segments/{seq}/retry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#1E293B;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="490" width="380" height="70" as="geometry"/></mxCell><mxCell id="b10" value="说明：分块上传 + 逐片转写（非 WebSocket/SSE 流式）；已确认音频（有 record_id）不可删除；时间偏移以 offset_seconds 记录。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=14;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1420" height="60" as="geometry"/></mxCell><mxCell id="e0" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="html=1;rounded=0;endArrow=block;endFill=1;strokeColor=#64748B;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value