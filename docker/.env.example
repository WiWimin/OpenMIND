# App
APP_NAME=OpenMIND
APP_ENV=development
API_V1_PREFIX=/api/v1
# Required in non-development environments. Must be at least 32 random characters.
SECRET_KEY=change-me
# Set only while rotating SECRET_KEY so existing encrypted BYOK keys remain readable.
SECRET_KEY_PREVIOUS=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
#
# NOTE: `POSTGRES_HOST` / `DATABASE_URL` below point at `localhost` because they
# are used when the backend runs **directly on the host** (`cd backend && uvicorn ...`).
# Inside Docker Compose the backend container does NOT use these values: Compose
# injects its own `DATABASE_URL` pointing at the internal service name `db:5432`
# (see `docker/compose.dev.yml`). Never point a container at `localhost` to reach
# another container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openmind
DATABASE_URL=postgresql+psycopg://openmind:change-me@localhost:5432/openmind

# File storage (MVP: local persistent directory)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# AI providers (LLM + Embedding, called server-side only)
#
# BYOK：普通用户必须自备模型 Key（在「模型设置」页配置）。默认不自动回退到
# 下面的全局 Key，避免团队承担用户 Token 费用。仅当显式开启 ALLOW_GLOBAL_FALLBACK
# 时，未配置的用户才会回退到这里的全局配置（用于开发/管理员联调，生产勿开）。
ALLOW_GLOBAL_FALLBACK=false
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
# EMBEDDING_DIM must equal the provider's default vector size.
# text-embedding-v3 (Aliyun Bailian) defaults to 1024; changing model or
# dimension requires rebuilding the pgvector column before M04.
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# ASR provider (OpenAI-compatible /audio/transcriptions). Leave empty to keep audio disabled.
# Option A: external provider.
# Option B: local FunASR (SenseVoice, CPU profile):
#   docker compose -f docker/compose.dev.yml --env-file docker/.env --profile asr up -d --build asr
#   then set:
#   ASR_API_BASE=http://asr:8000/v1
#   ASR_API_KEY=local-dev   # FunASR ignores this; backend requires a non-empty value.
#   ASR_MODEL=sensevoice
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=

# Local FunASR service (used only with `--profile asr`).
FUNASR_DEVICE=cpu
FUNASR_MODEL=sensevoice
ASR_HOST_PORT=10096
# Keep false for public providers. Enable only for a self-hosted local model endpoint.
ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# CORS
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite build-time variables, never used by the backend runtime)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# Dev-server proxy target, read by vite.config.ts inside the Node process.
# When the dev server runs in a container, the backend is reachable as
# `backend:8000`; the container's own localhost does NOT point at the backend.
# Leave unset when running `npm run dev` directly on the host, so the built-in
# default `http://localhost:8000` applies.
# VITE_DEV_PROXY_TARGET=http://backend:8000
