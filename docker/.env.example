# App
APP_NAME=OpenMIND
APP_ENV=development
API_V1_PREFIX=/api/v1
# Required in non-development environments. Must be at least 32 random characters.
SECRET_KEY=change-me
# Set only while rotating SECRET_KEY so existing encrypted BYOK keys remain readable.
SECRET_KEY_PREVIOUS=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT 签名算法（默认 HS256，一般无需修改）
JWT_ALGORITHM=HS256

# Database (PostgreSQL + pgvector)
#
# NOTE: `POSTGRES_HOST` / `DATABASE_URL` below point at `localhost` because they
# are used when the backend runs **directly on the host** (`cd backend && uvicorn ...`).
# Inside Docker Compose the backend container does NOT use these values: Compose
# injects its own `DATABASE_URL` pointing at the internal service name `db:5432`
# (see `docker/compose.dev.yml`). Never point a container at `localhost` to reach
# another container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=openmind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openmind
DATABASE_URL=postgresql+psycopg://openmind:change-me@localhost:5432/openmind

# File storage (MVP: local persistent directory)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=20

# AI providers (LLM + Embedding, called server-side only)
#
# LLM 走 BYOK：普通用户须在「模型配置」弹窗自备 Key。默认不自动回退到
# 下面的全局 Key，避免团队承担用户 Token 费用。仅当显式开启 ALLOW_GLOBAL_FALLBACK
# 时，未配置的用户才会回退到这里的全局 LLM 配置（用于开发/管理员联调，生产勿开）。
# 注意：该开关只作用于 LLM；向量模型始终使用本文件的 EMBEDDING_* 全局配置。
ALLOW_GLOBAL_FALLBACK=false
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=gpt-4o-mini
# 向量模型为服务端统一配置（用户不可自备），RAG / 知识库 / 材料索引依赖它，
# 部署时必须填写，否则相关功能提示「服务端未配置向量模型」。
# EMBEDDING_DIM must equal the provider's default vector size.
# text-embedding-v3 (Aliyun Bailian) defaults to 1024; changing model or
# dimension requires rebuilding the pgvector column before M04.
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
# ASR provider (OpenAI-compatible /audio/transcriptions). Leave empty to keep audio disabled.
# Option A: external provider.
# Option B: local FunASR (SenseVoice, CPU profile):
#   docker compose -f docker/compose.dev.yml --env-file docker/.env --profile asr up -d --build asr
#   then set:
#   ASR_API_BASE=http://asr:8000/v1
#   ASR_API_KEY=local-dev   # FunASR ignores this; backend requires a non-empty value.
#   ASR_MODEL=sensevoice
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=

# Local FunASR service (used only with `--profile asr`).
FUNASR_DEVICE=cpu
FUNASR_MODEL=sensevoice
ASR_HOST_PORT=10096
# Keep false for public providers. Enable only for a self-hosted local model endpoint.
ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# ---- AI 调用底座（ai/connection.py + ai/retry.py）----
# 连接池：按 api_base 进程内复用 httpx 客户端（keep-alive），false 时按次新建（回滚开关）
AI_CONNECTION_POOL_ENABLED=true
AI_MAX_CONNECTIONS=20
AI_MAX_KEEPALIVE_CONNECTIONS=10
AI_KEEPALIVE_EXPIRY_S=30
# LLM 非幂等调用的全局 deadline（含重试与退避的总预算，秒）；<=0 关闭。
# 注意：非幂等请求的读超时不会重传（避免重复计费），本预算只约束重试与退避。
AI_CALL_DEADLINE_S=90

# ---- 并发闸门与熔断（ai/resilience.py）----
# 总开关：false 时闸门与熔断全部直通（回滚用）
AI_RESILIENCE_ENABLED=true
# 每个 API 地址的在途请求上限（进程内计数，多 worker 不共享）
AI_MAX_CONCURRENCY_PER_PROVIDER=8
# 排队等待上限（秒），超时返回 429 RATE_LIMITED（details.scope=concurrency）
AI_CONCURRENCY_TIMEOUT_S=5
# 熔断：窗口期内失败达到阈值即打开（仅 5xx/超时/传输中断计入）
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_WINDOW_SECONDS=60
# 打开后冷却秒数，到点放行 1 个探针，成功即闭合
AI_CIRCUIT_OPEN_SECONDS=30

# RAG 相关性 Judge（ai/rag/relevance.py）：top1 低于阈值时对 top3 候选做
# LLM 结构化复核，拦截“分数够但答不了”的负样本；Judge 不可用自动回退分数判定。
RAG_JUDGE_ENABLED=true
RAG_JUDGE_MIN_SCORE=0.6

# RAG 检索性能告警（窗口 P95 超阈值时打 logger.error 告警行；<=0 关闭该告警）
# 候选行数告警用于提前识别应用层余弦的性能拐点（pgvector 改造依据）
RAG_ALERT_TOTAL_MS_P95=3000
RAG_ALERT_CANDIDATE_ROWS_P95=5000
RAG_ALERT_COOLDOWN_S=60

# 联网检索（答案层后置补救：资料无证据时先告知再联网作答）
# bing（默认，本环境可达）| ddg（需网络可达 DuckDuckGo）
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=bing
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_S=10

# CORS
# 逗号分隔的白名单，禁止使用通配符 *；可配多个域名
CORS_ORIGINS=http://localhost:5173

# 运维指标 /api/v1/metrics（需登录）；生产建议关闭或仅内网可达
METRICS_ENABLED=true

# 限流（进程内滑动窗口；多 worker/多实例下不共享，仅单实例有效）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
# 仅在受信反向代理后开启（信任 X-Forwarded-For 计算客户端 IP）
TRUST_PROXY_HEADERS=false
RATE_LIMIT_MAX_KEYS=10000

# 异步长任务（async_jobs + BackgroundTasks；单实例，进程重启丢 pending 任务，
# 启动与读取时回收为 failed JOB_TIMEOUT）。false 时长任务入口走原同步逻辑（回滚开关）
ASYNC_JOBS_ENABLED=true
# 僵尸任务判定窗口（分钟）：pending 超窗（重启丢失）或 running 超时 → failed JOB_TIMEOUT
ASYNC_JOB_STALE_MINUTES=30

# SSE 流式问答（POST /meetings/{id}/chat/stream）。false 时端点返回 404，前端回退同步 /chat
SSE_CHAT_ENABLED=true
# 心跳间隔（秒）：无增量时发送 `: ping` 注释行，<=0 关闭心跳
SSE_HEARTBEAT_SECONDS=15

# Frontend (Vite build-time variables, never used by the backend runtime)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Dev-server proxy target, read by vite.config.ts inside the Node process.
# When the dev server runs in a container, the backend is reachable as
# `backend:8000`; the container's own localhost does NOT point at the backend.
# Leave unset when running `npm run dev` directly on the host, so the built-in
# default `http://localhost:8000` applies.
# VITE_DEV_PROXY_TARGET=http://backend:8000
# Optional pip mirror for docker builds (slow networks)
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
